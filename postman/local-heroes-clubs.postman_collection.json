                  "pm.test('Lists every invalid field', () => pm.expect(fields).to.include.members(",
                  "  ['club.name', 'club.contactPhone', 'club.contactEmail', 'representative.email', 'representative.password'],",
                  "));"
                ]
              }
            }
          ],
