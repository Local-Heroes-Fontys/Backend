# Copy this file to .env and adjust the values. Never commit .env.
NODE_ENV=development
PORT=3000

# Frontend URL that is allowed to call the API (Vite's default dev server)
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=local_heroes
DB_USER=local_heroes
DB_PASSWORD=change_me
# Only used by docker-compose.yml
DB_ROOT_PASSWORD=change_me_too

# Secret used to sign and verify login tokens. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_value_of_32_chars_or_more
