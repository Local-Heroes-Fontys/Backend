# Copy this file to .env and adjust the values. Never commit .env.
NODE_ENV=development
PORT=3000

# Frontend URL that is allowed to call the API (Vite's default dev server)
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=local_heroes
DB_USER=local_heroes
DB_PASSWORD=change_me
# Only used by docker-compose.yml
DB_ROOT_PASSWORD=change_me_too
